local function getHRP(plr)
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function pushAll()
    local me = getHRP(LocalPlayer)
    if not me then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local hrp = getHRP(plr)
            if hrp then
                local dir = (hrp.Position - me.Position).Unit
                hrp.AssemblyLinearVelocity = dir * 250 + Vector3.new(0, 200, 0)
            end
        end
    end
end

local function pullAll()
    local me = getHRP(LocalPlayer)
    if not me then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local hrp = getHRP(plr)
            if hrp then
                hrp.CFrame = CFrame.new(me.Position + Vector3.new(math.random(-6,6), 5, math.random(-6,6)))
            end
        end
    end
end

local function skyAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        local hrp = getHRP(plr)
        if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 350, 0) end
    end
end

local function killAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
        end
    end
end

local function flingAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local hrp = getHRP(plr)
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.new(
                    math.random(-500,500), math.random(200,500), math.random(-500,500))
                hrp.RotVelocity = Vector3.new(
                    math.random(-50,50), math.random(-50,50), math.random(-50,50))
            end
        end
    end
end

local function freezeAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local hrp = getHRP(plr)
            if hrp then hrp.Anchored = true end
        end
    end
end

local function unfreezeAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        local hrp = getHRP(plr)
        if hrp then hrp.Anchored = false end
    end
end

