local function makeSlider(parent, text, min, max, default, callback)
    local holder = Instance.new("Frame", parent)
    holder.Size = UDim2.new(1,0,0,42)
    holder.BackgroundTransparency = 1
    holder.ZIndex = 7

    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1,0,0,14)
    lbl.BackgroundTransparency = 1
    lbl.Text = text .. ": " .. tostring(default)
    lbl.TextColor3 = TEXTDIM
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 8

    local bar = Instance.new("Frame", holder)
    bar.Size = UDim2.new(1,0,0,6)
    bar.Position = UDim2.new(0,0,0,20)
    bar.BackgroundColor3 = Color3.fromRGB(35,35,45)
    bar.BorderSizePixel = 0
    bar.ZIndex = 8
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = ACCENT1
    fill.BorderSizePixel = 0
    fill.ZIndex = 9
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

    local dragging = false
    local function update(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor((min + (max - min) * rel) * 100) / 100
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = text .. ": " .. tostring(val)
        if callback then callback(val) end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function makeDropdown(parent, text, options, default, callback)
    local holder = Instance.new("Frame", parent)
    holder.Size = UDim2.new(1,0,0,52)
    holder.BackgroundTransparency = 1
    holder.ZIndex = 7

    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1,0,0,16)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = TEXTDIM
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 8

    local row = Instance.new("Frame", holder)
    row.Size = UDim2.new(1,0,0,30)
    row.Position = UDim2.new(0,0,0,18)
    row.BackgroundTransparency = 1
    row.ZIndex = 8
    local rl = Instance.new("UIListLayout", row)
    rl.FillDirection = Enum.FillDirection.Horizontal
    rl.Padding = UDim.new(0,4)

    local buttons = {}
    for _, opt in ipairs(options) do
        local b = Instance.new("TextButton", row)
        b.Size = UDim2.new(0, 60, 1, 0)
        b.BackgroundColor3 = (opt == default) and ACCENT1 or Color3.fromRGB(35,35,45)
        b.Text = opt
        b.TextColor3 = (opt == default) and Color3.new(1,1,1) or TEXTDIM
        b.Font = Enum.Font.GothamBold
        b.TextSize = 10
        b.BorderSizePixel = 0
        b.ZIndex = 9
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,5)

        b.MouseButton1Click:Connect(function()
            for _, other in ipairs(buttons) do
                other.BackgroundColor3 = Color3.fromRGB(35,35,45)
                other.TextColor3 = TEXTDIM
            end
            b.BackgroundColor3 = ACCENT1
            b.TextColor3 = Color3.new(1,1,1)
            if callback then callback(opt) end
        end)
        table.insert(buttons, b)
    end
    return holder
end

