-- AIMBOT 100% AUTOMÁTICO (só ativar!)
--============================================================
local function getBestHead()
    local bestHead, bestScore = nil, math.huge
    local cx, cy = Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char and isAlive(char) and not (CONFIG.AimTeamCheck and sameTeam(plr)) then
                local head = getPart(char, "Head")
                local hrp = getPart(char, "HumanoidRootPart")
                if head and hrp then
                    local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if dist <= CONFIG.AimMaxDistance then
                        if isVisible(head) then
                            local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen and sp.Z > 0 then
                                local dx, dy = sp.X - cx, sp.Y - cy
                                local sd = math.sqrt(dx*dx + dy*dy)
                                if sd <= CONFIG.AimFOV and sd < bestScore then
                                    bestScore = sd
                                    bestHead = head
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestHead
end

-- Loop roda SEMPRE, mas só age se CONFIG.AimEnabled = true
-- Sem clique, sem tecla, sem HOLD. Só ativar o toggle.
RunService:BindToRenderStep("MALOKAS_Aim", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not CONFIG.AimEnabled then return end
    if not LocalPlayer.Character then return end

    local head = getBestHead()
    if not head then return end

    local targetPos = head.Position
    if CONFIG.AimPrediction > 0 then
        local vel = head.AssemblyLinearVelocity or Vector3.zero
        targetPos = targetPos + vel * CONFIG.AimPrediction
    end

    local camPos = Camera.CFrame.Position
    local goal = CFrame.lookAt(camPos, targetPos)
    local speed = math.clamp(CONFIG.AimSmoothness, 0.05, 1)
    local alpha = 1 - (1 - speed)^(dt * 60)
    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end)

