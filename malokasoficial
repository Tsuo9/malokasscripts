RunService.RenderStepped:Connect(function()
    rainbowTime = tick()

    FovCircle.Size = UDim2.new(0, CONFIG.AimFOV*2, 0, CONFIG.AimFOV*2)
    FovCircle.Visible = CONFIG.AimEnabled and CONFIG.ESPFovCircle
    if CONFIG.AimEnabled then fcs.Color = getRainbowColor(0) end

    if not espBuilt then return end

    for plr, d in pairs(espData) do
        local char = plr.Character
        local on = CONFIG.ESPEnabled and char and isAlive(char) and not (CONFIG.ESPTeamCheck and sameTeam(plr))

        if on then
            local hrp = getPart(char, "HumanoidRootPart")
            local head = getPart(char, "Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp and head and hum then
                local pos, onScreen, depth = worldToScreen(hrp.Position)
                if onScreen and depth > 0 then
                    d.draw.Visible = true
                    local topPos = worldToScreen(head.Position + Vector3.new(0, 0.6, 0))
                    local botPos = worldToScreen(hrp.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(botPos.Y - topPos.Y)
                    local width = height * 0.55
                    local boxX = pos.X - width/2
                    local boxY = topPos.Y
                    local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local playerOffset = (plr.UserId % 100) / 100
                    local rainbowColor = getRainbowColor(playerOffset)

                    if CONFIG.ESPBox then
                        d.box.Visible = true
                        d.box.Size = UDim2.new(0, width, 0, height)
                        d.box.Position = UDim2.new(0, boxX, 0, boxY)
                        d.boxStroke.Color = rainbowColor
                        if CONFIG.ESPBoxFill then
                            d.boxFill.Visible = true
                            d.boxFill.BackgroundColor3 = getNormalColor(ratio, "outline")
                        else
                            d.boxFill.Visible = false
                        end
                    else
                        d.box.Visible = false
                        d.boxFill.Visible = false
                    end

                    if CONFIG.ESPTracer then
                        local originP = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        local targetP = Vector2.new(pos.X, botPos.Y)
                        setLine(d.tracer, originP, targetP)
                        d.tracer.BackgroundColor3 = rainbowColor
                    else
                        d.tracer.Visible = false
                    end

                    if CONFIG.ESPSkeleton then
                        d.skHolder.Visible = true
                        local function L(i, a, b)
                            if a and b then
                                local p1, on1 = worldToScreen(a.Position)
                                local p2, on2 = worldToScreen(b.Position)
                                if on1 and on2 then
                                    setLine(d.skLines[i], p1, p2)
                                    d.skLines[i].BackgroundColor3 = rainbowColor
                                else
                                    d.skLines[i].Visible = false
                                end
                            else
                                d.skLines[i].Visible = false
                            end
                        end
                        local H  = getPart(char, "Head")
                        local UT = getPart(char, "UpperTorso", "Torso")
                        local LT = getPart(char, "LowerTorso", "Torso")
                        local LA = getPart(char, "LeftUpperArm", "Left Arm")
                        local RA = getPart(char, "RightUpperArm", "Right Arm")
                        local LH = getPart(char, "LeftHand", "Left Arm")
                        local RH = getPart(char, "RightHand", "Right Arm")
                        local LL = getPart(char, "LeftUpperLeg", "Left Leg")
                        local RL = getPart(char, "RightUpperLeg", "Right Leg")
                        local LF = getPart(char, "LeftFoot", "Left Leg")
