--============================================================
-- SISTEMA PEGAR / ARREMESSAR
--============================================================
local GrabSystem = {
    Holding = false,
    GrabbedModel = nil,
    GrabbedParts = {},
    GrabbedVelocities = {},
    OriginalAnchors = {},
    OriginalCFrames = {},
}

local function getModelUnderMouse()
    local mouse = LocalPlayer:GetMouse()
    if not mouse or not mouse.Target then return nil end
    local part = mouse.Target
    if not part or not part:IsDescendantOf(Workspace) then return nil end

    -- Ignora o próprio personagem
    local char = LocalPlayer.Character
    if char and part:IsDescendantOf(char) then return nil end

    -- Tenta achar um Model ancestral (carro, mesa, npc)
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model ~= char then
        return model
    end
    -- Se não tiver Model, retorna a própria peça
    return part
end

local function grabModel(model)
    if GrabSystem.Holding then return end
    if not model then return end

    -- Coleta todas as partes e salva estado
    local parts = {}
    local anchorState = {}
    local cframes = {}
    local isModel = model:IsA("Model")

    if isModel then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                table.insert(parts, p)
                anchorState[p] = p.Anchored
                cframes[p] = p.CFrame
            end
        end
    elseif model:IsA("BasePart") then
        table.insert(parts, model)
        anchorState[model] = model.Anchored
        cframes[model] = model.CFrame
    end

    if #parts == 0 then return end

    GrabSystem.Holding = true
    GrabSystem.GrabbedModel = model
    GrabSystem.GrabbedParts = parts
    GrabSystem.OriginalAnchors = anchorState
    GrabSystem.OriginalCFrames = cframes

    -- Ancora todas pra segurar sem cair
    for _, p in ipairs(parts) do
        pcall(function()
            p.Anchored = true
            p.Massless = true
        end)
    end
end

local function releaseModel()
    if not GrabSystem.Holding then return end
    for _, p in ipairs(GrabSystem.GrabbedParts) do
        if p and p.Parent then
            pcall(function()
                p.Anchored = false
                p.Massless = false
            end)
        end
    end
    GrabSystem.Holding = false
    GrabSystem.GrabbedModel = nil
    GrabSystem.GrabbedParts = {}
end

local function throwModel(strong)
    if not GrabSystem.Holding then
        -- Se não está segurando, pega o que está na mira e arremessa
        local m = getModelUnderMouse()
        if not m then return end
        grabModel(m)
        task.wait(0.05)
    end
    if not GrabSystem.Holding then return end

    local force = strong and CONFIG.ThrowForceMax or CONFIG.ThrowForce
    local up = CONFIG.ThrowUpForce
    local spin = CONFIG.ThrowSpin

    local camLook = Camera.CFrame.LookVector
    local dir = Vector3.new(camLook.X, camLook.Y * 0.3, camLook.Z)
    if dir.Magnitude > 0 then
        dir = dir.Unit
    else
        dir = Vector3.new(0, 0, -1)
    end

    local parts = GrabSystem.GrabbedParts
    for _, p in ipairs(parts) do
        if p and p.Parent then
            pcall(function()
                p.Anchored = false
                p.Massless = false
                p.AssemblyLinearVelocity = dir * force + Vector3.new(0, up, 0)
                p.AssemblyAngularVelocity = Vector3.new(
                    math.random(-spin, spin),
                    math.random(-spin, spin),
                    math.random(-spin, spin)
                )
            end)
        end
    end

    GrabSystem.Holding = false
    GrabSystem.GrabbedModel = nil
    GrabSystem.GrabbedParts = {}
end

-- Loop: mantém o model seguindo a mira enquanto segura
RunService.RenderStepped:Connect(function()
    if not GrabSystem.Holding then return end
    if not GrabSystem.GrabbedModel then return end

    local char = LocalPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    -- Ponto alvo na frente da câmera
    local targetPos = Camera.CFrame.Position + Camera.CFrame.LookVector * CONFIG.GrabDistance

    -- Calcula o centro atual do model
    local center = Vector3.zero
    local count = 0
    for _, p in ipairs(GrabSystem.GrabbedParts) do
        if p and p.Parent then
            center = center + p.Position
            count = count + 1
        end
    end
    if count == 0 then
        releaseModel()
        return
    end
    center = center / count

    local offset = targetPos - center

    -- Move todas as partes
    for _, p in ipairs(GrabSystem.GrabbedParts) do
        if p and p.Parent then
            pcall(function()
                p.CFrame = p.CFrame + offset
            end)
        end
    end
end)

