local function isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function sameTeam(plr)
    if not plr.Team or not LocalPlayer.Team then return false end
    return plr.Team == LocalPlayer.Team
end

local function getPart(char, ...)
    if not char then return nil end
    for _, n in ipairs({...}) do
        local p = char:FindFirstChild(n)
        if p then return p end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, n in ipairs({...}) do
            local p = hum:FindFirstChild(n)
            if p then return p end
        end
    end
    return nil
end

local function isVisible(targetPart)
    if not CONFIG.AimVisibleOnly then return true end
    local origin = Camera.CFrame.Position
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, ScreenGui}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(origin, dir, params)
    if result and result.Instance then
        return result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

local function worldToScreen(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end

