local Pages = {}

local function makeTab(name, display, width)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, width, 1, -6)
    btn.BackgroundColor3 = Color3.fromRGB(30,30,40)
    btn.BackgroundTransparency = 0.3
    btn.Text = display
    btn.TextColor3 = TEXTDIM
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.ZIndex = 8
    btn.Parent = TabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1,-12,1,-96)
    page.Position = UDim2.new(0,6,0,90)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = ACCENT1
    page.CanvasSize = UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.ZIndex = 6
    page.Parent = Panel
    local pl = Instance.new("UIListLayout", page)
    pl.Padding = UDim.new(0,5)
    pl.SortOrder = Enum.SortOrder.LayoutOrder

    Pages[name] = {btn=btn, page=page}
    return page
end

