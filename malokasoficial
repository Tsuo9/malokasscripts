local function selectTab(name)
    for n, d in pairs(Pages) do
        local on = (n == name)
        d.page.Visible = on
        d.btn.BackgroundColor3 = on and ACCENT1 or Color3.fromRGB(30,30,40)
        d.btn.BackgroundTransparency = on and 0 or 0.3
        d.btn.TextColor3 = on and Color3.new(1,1,1) or TEXTDIM
    end
end

